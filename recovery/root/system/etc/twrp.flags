# mount point		fs		device						device2			 device3			flags
# User writeable partitions (A/B)
/boot			emmc		/dev/block/by-name/boot				flags=display=boot;slotselect;backup;flashimg
/init_boot		emmc		/dev/block/by-name/init_boot			flags=display=init_boot;slotselect;backup;flashimg
/vendor_boot		emmc		/dev/block/by-name/vendor_boot			flags=display=vendor_boot;slotselect;backup;flashimg
/dtbo			emmc		/dev/block/by-name/dtbo				flags=display=dtbo;slotselect;backup;flashimg
/logo			emmc		/dev/block/by-name/logo				flags=display=logo;slotselect;backup;flashimg
/lk			emmc		/dev/block/by-name/lk				flags=display=lk;slotselect;backup;flashimg
/vbmeta			emmc		/dev/block/by-name/vbmeta			flags=display=vbmeta;slotselect;backup;flashimg
/vbmeta_system		emmc		/dev/block/by-name/vbmeta_system		flags=display=vbmeta_system;slotselect;backup
/vbmeta_vendor		emmc		/dev/block/by-name/vbmeta_vendor		flags=display=vbmeta_vendor;slotselect;backup

# Metadata / misc
/metadata		ext4		/dev/block/by-name/md_udc			flags=display=metadata;backup
/misc			emmc		/dev/block/by-name/para				flags=display=misc;backup

# Sensitive data
/nvcfg			ext4		/dev/block/by-name/nvcfg			flags=display=nvcfg;backup
/persist		ext4		/dev/block/by-name/persist			flags=display=persist;backup
/frp			emmc		/dev/block/by-name/frp				flags=display=frp;backup
/nvdata			ext4		/dev/block/by-name/nvdata			flags=display=nvdata;backup
/protect_1		ext4		/dev/block/by-name/protect1			flags=display=protect_1;backup
/protect_2		ext4		/dev/block/by-name/protect2			flags=display=protect_2;backup
/expdb			emmc		/dev/block/by-name/expdb			flags=display=expdb;backup
/seccfg			emmc		/dev/block/by-name/seccfg			flags=display=seccfg;backup
/sec1			emmc		/dev/block/by-name/sec1				flags=display=sec1;backup
/flashinfo		emmc		/dev/block/by-name/flashinfo			flags=display=flashinfo;backup
/boot_para		emmc		/dev/block/by-name/boot_para			flags=display=boot_para

# IMEI / modem
/nvram			emmc		/dev/block/by-name/nvram			flags=display=nvram;backup
/proinfo		emmc		/dev/block/by-name/proinfo			flags=display=proinfo;backup
/md1img			emmc		/dev/block/by-name/md1img			flags=display=md1img;slotselect;backup

# MediaTek firmware (A/B via slotselect)
/gz			emmc		/dev/block/by-name/gz				flags=display=gz;slotselect;backup
/scp			emmc		/dev/block/by-name/scp				flags=display=scp;slotselect;backup
/sspm			emmc		/dev/block/by-name/sspm				flags=display=sspm;slotselect;backup
/spmfw			emmc		/dev/block/by-name/spmfw			flags=display=spmfw;slotselect;backup
/tee			emmc		/dev/block/by-name/tee				flags=display=tee;slotselect;backup
/tkv			emmc		/dev/block/by-name/tkv				flags=display=tkv;slotselect;backup

# Removable Storage
/external_sd		auto		/dev/block/mmcblk1p1	/dev/block/mmcblk0p1	flags=display="Micro SD Card";storage;wipeingui;removable;backup=0
/usb-otg		auto		/dev/block/sdd1		/dev/block/sdd		flags=display="USB OTG";storage;wipeingui;removable

# Flashable logical partitions
/system_image		emmc		/dev/block/mapper/system			flags=display="system";slotselect;backup;flashimg
/vendor_image		emmc		/dev/block/mapper/vendor			flags=display="vendor image";slotselect;backup;flashimg
/system_ext_image	emmc		/dev/block/mapper/system_ext			flags=display="System_EXT image";slotselect;backup;flashimg
/product_image		emmc		/dev/block/mapper/product			flags=display="Product image";slotselect;backup;flashimg
